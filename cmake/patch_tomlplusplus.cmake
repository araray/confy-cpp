# Fixes a toml++ 3.4.0 defect: is_non_ascii_horizontal_whitespace() reaches
# TOML_UNREACHABLE (undefined behaviour) for any non-whitespace character in
# U+00A1–U+0499 or U+2CAE–U+30A7 — common letters such as "ç" in a document.
# Found by Sigilo's fuzz_config. Those characters are not whitespace: return false.
set(f "${SOURCE_DIR}/include/toml++/impl/unicode_autogenerated.hpp")
file(READ "${f}" text)
set(bad "			case 0x07:
				return (U'\\u2000' <= c && c <= U'\\u200B') || (U'\\u205F' <= c && c <= U'\\u2060') || c == U'\\u202F';
			default: TOML_UNREACHABLE;
		}

		TOML_UNREACHABLE;")
set(good "			case 0x07:
				return (U'\\u2000' <= c && c <= U'\\u200B') || (U'\\u205F' <= c && c <= U'\\u2060') || c == U'\\u202F';
			default: return false; // confy-cpp patch: was TOML_UNREACHABLE
		}")
string(FIND "${text}" "${bad}" pos)
if(pos GREATER -1)
    string(REPLACE "${bad}" "${good}" text "${text}")
    file(WRITE "${f}" "${text}")
    message(STATUS "confy: patched toml++ is_non_ascii_horizontal_whitespace")
endif()
# The single-header copy carries the same function.
set(f2 "${SOURCE_DIR}/toml.hpp")
if(EXISTS "${f2}")
    file(READ "${f2}" t2)
    string(REPLACE "${bad}" "${good}" t2 "${t2}")
    file(WRITE "${f2}" "${t2}")
endif()
